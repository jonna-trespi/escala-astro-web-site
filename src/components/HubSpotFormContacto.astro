---
/**
 * HubSpot Form Embed — Estilo formulario de contacto (contacto.astro)
 *
 * Mismo formulario que HubSpotForm.astro pero con el look del form de la página Contacto:
 * fondo claro, inputs blancos con borde oscuro, botones tipo "interest-btn", CTA centrado turquesa.
 */
interface Props {
  class?: string;
  lang?: 'es' | 'en' | 'pt';
}

const { class: className = '', lang = 'es' } = Astro.props;

const labelTranslations: Record<string, { es: string; en: string; pt: string }> = {
  'First Name': { es: 'Nombre', en: 'First Name', pt: 'Nome' },
  'Last Name': { es: 'Apellido', en: 'Last Name', pt: 'Sobrenome' },
  'Email': { es: 'Correo electrónico', en: 'Email', pt: 'E-mail' },
  'Email*': { es: 'Correo electrónico', en: 'Email', pt: 'E-mail' },
  'Company name': { es: 'Empresa', en: 'Company name', pt: 'Nome da empresa' },
  'Company name*': { es: 'Empresa', en: 'Company name', pt: 'Nome da empresa' },
  'Company Name': { es: 'Empresa', en: 'Company name', pt: 'Nome da empresa' },
  'Phone': { es: 'Teléfono', en: 'Phone', pt: 'Telefone' },
  'Country': { es: 'País', en: 'Country', pt: 'País' },
  'Message': { es: 'Mensaje', en: 'Message', pt: 'Mensagem' },
  'Comments': { es: 'Comentarios', en: 'Comments', pt: 'Comentários' },
};

/** Traducciones para checkboxes: términos/condiciones y temas de interés. Clave puede estar en EN o ES. */
const checkboxLabelTranslations: Record<string, { es: string; en: string; pt: string }> = {
  "I agree to receive other communications from Escala24x7.": {
    es: "Acepto recibir otras comunicaciones de Escala24x7.",
    en: "I agree to receive other communications from Escala24x7.",
    pt: "Concordo em receber outras comunicações da Escala24x7.",
  },
  "I agree to allow Escala24x7 to store and process my personal data.": {
    es: "Acepto que Escala24x7 almacene y procese mis datos personales.",
    en: "I agree to allow Escala24x7 to store and process my personal data.",
    pt: "Concordo que a Escala24x7 armazene e processe meus dados pessoais.",
  },
  "Temas de interés": { es: "Temas de interés", en: "Topics of interest", pt: "Temas de interesse" },
  "Topics of interest": { es: "Temas de interés", en: "Topics of interest", pt: "Temas de interesse" },
  "Migración": { es: "Migración", en: "Migration", pt: "Migração" },
  "Migration": { es: "Migración", en: "Migration", pt: "Migração" },
  "Modernización": { es: "Modernización", en: "Modernization", pt: "Modernização" },
  "Modernization": { es: "Modernización", en: "Modernization", pt: "Modernização" },
  "Seguridad": { es: "Seguridad", en: "Security", pt: "Segurança" },
  "Security": { es: "Seguridad", en: "Security", pt: "Segurança" },
  "Resiliencia": { es: "Resiliencia", en: "Resilience", pt: "Resiliência" },
  "Resilience": { es: "Resiliencia", en: "Resilience", pt: "Resiliência" },
  "FinOps": { es: "FinOps", en: "FinOps", pt: "FinOps" },
  "Análisis de Datos": { es: "Análisis de Datos", en: "Data Analytics", pt: "Análise de Dados" },
  "Data Analytics": { es: "Análisis de Datos", en: "Data Analytics", pt: "Análise de Dados" },
  "Inteligencia Artificial Generativa": { es: "Inteligencia Artificial Generativa", en: "Generative AI", pt: "Inteligência Artificial Generativa" },
  "Generative AI": { es: "Inteligencia Artificial Generativa", en: "Generative AI", pt: "Inteligência Artificial Generativa" },
  "Automatización de Procesos con IA": { es: "Automatización de Procesos con IA", en: "AI Process Automation", pt: "Automação de Processos com IA" },
  "AI Process Automation": { es: "Automatización de Procesos con IA", en: "AI Process Automation", pt: "Automação de Processos com IA" },
  "IBM Power a AWS": { es: "IBM Power a AWS", en: "IBM Power to AWS", pt: "IBM Power para AWS" },
  "IBM Power to AWS": { es: "IBM Power a AWS", en: "IBM Power to AWS", pt: "IBM Power para AWS" },
};

const submitButtonText: Record<string, string> = { es: 'Enviar', en: 'Submit', pt: 'Enviar' };
const submittedMessageText: Record<string, string> = { es: 'Formulario enviado', en: 'Form submitted', pt: 'Formulário enviado' };
const formId = '1dd7b115-dad7-46b7-8e07-7790e41cada3';
const portalId = '48294971';
---

<div class:list={['hubspot-form-wrapper', 'hubspot-form-contacto', className]} data-lang={lang}>
  <div
    class="hs-form-html"
    data-region="na1"
    data-form-id={formId}
    data-portal-id={portalId}
  ></div>
</div>

<script src={`https://js.hsforms.net/forms/embed/developer/${portalId}.js`} defer></script>
<script define:vars={{ labelTranslations, checkboxLabelTranslations, submitButtonText, submittedMessageText }}>
  (function () {
    const wrapper = document.querySelector('.hubspot-form-contacto') || document.querySelector('.hubspot-form-wrapper');
    if (!wrapper) return;
    const lang = (wrapper.getAttribute('data-lang') || 'es').toLowerCase();
    const langAttr = lang === 'es' ? 'es' : lang === 'pt' ? 'pt' : 'en';

    function applySubmittedMessage() {
      const msg = wrapper.querySelector('.submitted-message, [class*="submitted"], [class*="Submitted"]');
      if (msg && submittedMessageText[lang] && msg.textContent !== submittedMessageText[lang]) {
        msg.textContent = submittedMessageText[lang];
        return true;
      }
      return false;
    }

    function applySubmitButtonText() {
      const btn = wrapper.querySelector('button[type="submit"], input[type="submit"], .hsfc-Button');
      if (btn && submitButtonText[lang]) {
        if (btn.tagName === 'INPUT') btn.setAttribute('value', submitButtonText[lang]);
        else btn.textContent = submitButtonText[lang];
        return true;
      }
      return false;
    }

    function getTranslation(labelText) {
      const key = labelText.trim();
      const t = labelTranslations[key] || labelTranslations[key.replace(/\*$/, '')];
      if (t && t[lang]) return t[lang];
      return key;
    }

    function getCheckboxTranslation(text) {
      const key = text.trim();
      const keyNormalized = key.replace(/\s*\*+\s*$/, '').trim();
      const t = checkboxLabelTranslations[key] || checkboxLabelTranslations[keyNormalized];
      if (t && t[lang]) return t[lang];
      return key;
    }

    function isPhoneOrDropdownLabel(label) {
      return !!(label.closest('.hsfc-PhoneInput') || label.closest('.hsfc-DropdownOptions'));
    }

    /** Traduce labels de checkboxes, radios y títulos de grupo (términos, temas de interés) y corrige lang. */
    function applyCheckboxAndRadioLabels() {
      const form = wrapper.querySelector('form');
      if (!form) return false;
      const labels = form.querySelectorAll('label[id$="-label"], label.hsfc-FieldLabel, .hs-form-field label, .hsfc-CheckboxFieldGroup__Options label, .hsfc-CheckboxFieldGroup_Options label, .hsfc-CheckboxFieldGroup label, [data-hsfc-id="CheckboxFieldGroup"] label');
      let applied = 0;
      labels.forEach(function (label) {
        if (isPhoneOrDropdownLabel(label)) return;
        const span = label.querySelector('span');
        const rawText = (span ? span.textContent : label.textContent) || '';
        const text = rawText.trim();
        if (!text) return;
        const translated = getCheckboxTranslation(text);
        if (translated === text) return;
        const suffix = (text.match(/\s*\*+\s*$/) || [])[0] || '';
        const finalText = translated + suffix;
        if (span) {
          span.textContent = finalText;
        } else {
          label.textContent = finalText;
        }
        label.setAttribute('lang', langAttr);
        applied++;
      });
      return applied > 0;
    }

    function applyPlaceholdersAndHideLabels() {
      const form = wrapper.querySelector('form');
      if (!form) return false;
      const labels = form.querySelectorAll('label[id$="-label"], label.hsfc-FieldLabel, .hs-form-field label');
      if (labels.length === 0) return false;
      let applied = 0;
      labels.forEach(function (label) {
        if (isPhoneOrDropdownLabel(label)) return;
        const span = label.querySelector('span');
        const rawText = (span ? span.textContent : label.textContent) || '';
        const text = rawText.trim();
        if (!text) return;
        const forId = label.getAttribute('for');
        const input = forId ? form.querySelector('#' + CSS.escape(forId)) : label.nextElementSibling;
        if (!input) return;
        if (input.closest('.hsfc-PhoneInput')) return;
        var type = (input.type || '').toLowerCase();
        var isCheckboxOrRadio = input.tagName === 'INPUT' && (type === 'checkbox' || type === 'radio');
        if (isCheckboxOrRadio) return;
        if (input.tagName === 'INPUT' || input.tagName === 'SELECT' || input.tagName === 'TEXTAREA') {
          const translated = getTranslation(text);
          input.setAttribute('placeholder', translated);
          if (span) span.textContent = translated;
          else label.textContent = translated;
          label.classList.add('hubspot-label-as-placeholder');
          applied++;
        }
      });
      if (applied > 0) wrapper.classList.add('hubspot-labels-as-placeholders');
      return applied > 0;
    }

    function onFormReady() {
      var labelsDone = applyPlaceholdersAndHideLabels();
      var checkboxDone = applyCheckboxAndRadioLabels();
      var btnDone = applySubmitButtonText();
      return labelsDone || checkboxDone || btnDone;
    }

    function shouldDisconnectObserver() {
      var phone = wrapper.querySelector('.hsfc-PhoneInput');
      if (!phone) return false;
      return (
        wrapper.classList.contains('hubspot-labels-as-placeholders') ||
        !wrapper.querySelector('form label.hsfc-FieldLabel:not(.hubspot-label-as-placeholder)')
      );
    }

    var observer = new MutationObserver(function () {
      onFormReady();
      if (shouldDisconnectObserver()) observer.disconnect();
    });
    observer.observe(wrapper, { childList: true, subtree: true });
    onFormReady();
    if (shouldDisconnectObserver()) observer.disconnect();
    setTimeout(function () {
      onFormReady();
      applyCheckboxAndRadioLabels();
      applySubmitButtonText();
      if (shouldDisconnectObserver()) observer.disconnect();
    }, 2000);
    setTimeout(function () { observer.disconnect(); }, 8000);
    setTimeout(function () { applyCheckboxAndRadioLabels(); }, 3500);
    setTimeout(function () { applyCheckboxAndRadioLabels(); }, 5500);
    var successCheck = setInterval(function () {
      if (applySubmittedMessage()) clearInterval(successCheck);
    }, 1500);
  })();
</script>

