---
import Header from "../../components/Header.astro";
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import Footer from "../../components/Footer.astro";
import BlogListingContent from "../../components/BlogListingContent.astro";
import blogPosts from "../../data/blog-posts.json";
import categories from "../../data/categories.json";

const lang = 'en';
const currentPath = Astro.url.pathname;
import "../../styles/global.css";
import "../../styles/blog-page.css";

const FEATURED_SLUG = 'nueva-imagen-escala24x7';

type Post = {
  slug: string;
  title: string;
  excerpt: string;
  thumbnail: string | null;
  previewImage: string | null;
  publishedOnFormatted: string;
  categoryName: string;
  categorySlug: string | null;
};

const allPosts = blogPosts as Post[];
const posts = allPosts.filter((p) => p.slug !== FEATURED_SLUG);
const categoriesList = (categories as Array<{ slug: string; name: string }>).filter(
  (c) => !['bigdata', 'casos-de-exito', 'cc', 'machine-learning'].includes(c.slug)
);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escala 24x7 Blog (English) | Cloud and AWS insights</title>
    <meta
      name="description"
      content="Cloud and AWS perspectives from Escala 24x7: migration, security, data, AI and operations. Premier Partner in Latin America — English blog index."
    />
    <link rel="icon" type="image/png" href="/icons/escala-favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <BlogListingContent blogBasePath="/en" posts={posts} categoriesList={categoriesList} />
    <Footer lang={lang} />

    <script>
      (function () {
        const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
        const searchBtn = document.getElementById('blog-search-btn');
        const tabs = document.querySelectorAll('.blog-tab');
        const featuredSection = document.getElementById('blog-featured-section') as HTMLElement | null;
        const cards = document.querySelectorAll('.blog-entry-card');
        const noResults = document.getElementById('blog-no-results') as HTMLElement | null;

        let currentCategory = '';

        function normalize(s: string | undefined | null): string {
          return (s || '').toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
        }

        function applyFilters() {
          const query = normalize(searchInput?.value ?? '').trim();
          let visibleCount = 0;

          cards.forEach(function (card) {
            const el = card as HTMLElement;
            const catSlug = (el.getAttribute('data-category-slug') || '').toLowerCase();
            const title = normalize(el.getAttribute('data-title'));
            const matchCategory = !currentCategory || catSlug === currentCategory;
            const matchSearch = !query || title.includes(query);
            const show = matchCategory && matchSearch;
            el.style.display = show ? '' : 'none';
            if (show) visibleCount++;
          });

          if (noResults) noResults.hidden = visibleCount > 0;

          if (featuredSection) {
            const showFeatured = !currentCategory && !query;
            featuredSection.style.display = showFeatured ? '' : 'none';
          }
        }

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
          searchInput.addEventListener('keydown', function (e: KeyboardEvent) { if (e.key === 'Enter') applyFilters(); });
        }
        if (searchBtn) searchBtn.addEventListener('click', applyFilters);

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function (e) {
            const clicked = e.currentTarget as HTMLElement;
            currentCategory = (clicked.getAttribute('data-category') || '').toLowerCase();
            tabs.forEach(function (t) {
              const active = (t.getAttribute('data-category') || '').toLowerCase() === currentCategory;
              t.classList.toggle('blog-tab--active', active);
              t.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            applyFilters();
          });
        });
      })();
    </script>
  </body>
</html>
