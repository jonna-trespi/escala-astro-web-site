---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HubSpotFormContacto from "../components/HubSpotFormContacto.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
const lang = 'es';
const currentPath = Astro.url.pathname;
import "../styles/global.css";

// Una sola fuente de verdad para el mapa: id, título, descripción, icono y posición (%). Añadir o editar aquí.
const mapLocations = [
  { id: 'argentina', title: 'Argentina', text: 'El Salvador 5218, Palermo, C1428 CABA, Argentina.', flag: '/icons/recursos/arg-icon.png', left: '51%', top: '88%' },
  { id: 'bolivia', title: 'Bolivia', text: 'Av Bonifacio Barrientos No. 64, Edificio Itaguazu, Piso 7, Ofic 19, UV: 0029 MZA:007 S/N Zona: Urbari; Santa Cruz de la Sierra.', flag: '/icons/recursos/bol-icon.png', left: '54%', top: '73%' },
  { id: 'chile', title: 'Chile', text: 'Providencia 1208 OF 215 2P, Comuna: Providencia, Santiago de Chile', flag: '/icons/recursos/chile-icon.png', left: '50%', top: '80%' },
  { id: 'colombia', title: 'Colombia', text: 'Avenida Calle 72 No. 10 - 51 Ofi. 401 Bogotá D.C', flag: '/icons/recursos/col-icon.png', left: '50%', top: '60%' },
  { id: 'costa-rica', title: 'Costa Rica', text: 'San Jose-Escazu San Rafael, Guachipelin, Amara Plaza, 4to piso, oficina 406.', flag: '/icons/recursos/cr-icon.png', left: '44%', top: '58%' },
  { id: 'ecuador', title: 'Ecuador', text: 'Av. Amazonas N21-147 y Vicente Ramón Roca, Edificio: Río Amazonas, Piso 7, oficina 701. Quito', flag: '/icons/recursos/ec-icon.png', left: '45%', top: '65%' },
  { id: 'salvador', title: 'El Salvador', text: 'Blvd. del Hipódromo, PSJ 11, Col. San Benito, #73, San Salvador.', flag: '/icons/recursos/sal-icon.png', left: '40%', top: '58%' },
  { id: 'españa', title: 'España', text: 'Naciones 10, 28006 Madrid', flag: '/icons/recursos/es-icon.png', left: '83%', top: '44%' },
  { id: 'usa', title: 'USA', text: '20900 NE 30th Av. Suite 607Aventura, FL 33180', flag: '/icons/recursos/usa-icon.png', left: '40%', top: '40%' },
  { id: 'guatemala', title: 'Guatemala', text: '6A Avenida 0-06 Torre II nivel 9 oficina 903 Zona 4 Guatemala', flag: '/icons/recursos/gua-icon.png', left: '38%', top: '55%' },
  { id: 'honduras', title: 'Honduras', text: 'Tegucigalpa, Edificio Torre Alianza 9No. Piso Blvd San Juan Bosco, Honduras', flag: '/icons/recursos/hon-icon.png', left: '41%', top: '54%' },
  { id: 'italia', title: 'Italia', text: 'Via Luca Gaurico 9/11 Roma, 00143', flag: '/icons/recursos/it-icon.png', left: '90%', top: '40%' },
  { id: 'mexico', title: 'México', text: 'Shakespeare 189, Colonia Anzures, Delegación Miguel Hidalgo. CP: 11590 CDMX', flag: '/icons/recursos/mex-icon.png', left: '33%', top: '50%' },
  { id: 'nicaragua', title: 'Nicaragua', text: 'Colonial Los Robles IV Etapa Casa No. 18. Managua', flag: '/icons/recursos/nic-icon.png', left: '42%', top: '56%' },
  { id: 'panama', title: 'Panamá', text: 'Corregimiento de San Francisco, Urb. San Francisco, Calle 69 y Vía Israel, Edificio PH Marina Plaza, Apto/Local 14-C, Ciudad de Panamá.', flag: '/icons/recursos/pan-icon.png', left: '47%', top: '59%' },
  { id: 'paraguay', title: 'Paraguay', text: 'Azara No 551 esq. Mexico, Edif. Don Juan Primer Piso, La Asunción, Paraguay', flag: '/icons/recursos/par-icon.png', left: '56%', top: '76%' },
  { id: 'peru', title: 'Perú', text: 'Av. Javier Prado Oeste, 658 INT. 801 5 cuadras antes de la Av. Brasil, Magdalena del Mar - Lima.', flag: '/icons/recursos/per-icon.png', left: '48%', top: '69%' },
  { id: 'dominicana', title: 'Republica Dominicana', text: 'Ave. José Ortega y Gasset No.28, Suite 2B, Edificio Madesor, Ensanche Naco, Santo Domingo.', flag: '/icons/recursos/dom-icon.png', left: '47%', top: '54%' },
  { id: 'uruguay', title: 'Uruguay', text: 'Luis Piera 1954 Apto 501, Montevideo, Uruguay', flag: '/icons/recursos/ur-icon.png', left: '54%', top: '84%' },
  { id: 'venezuela', title: 'Venezuela', text: 'Av. la Estancia CCCT, 2da etapa, Torre B, Nivel piso 12 ofb-1206. Urb Chuao Caracas. Edo. Miranda 1064', flag: '/icons/recursos/ven-icon.png', left: '55%', top: '61%' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacto - Escala 24x7</title>
    <meta name="description" content="Oficinas de Escala 24x7 en Latinoamérica, España, USA e Italia. Contáctanos para soluciones en la nube con expertos AWS." />
    <link rel="canonical" href={`https://www.escala24x7.com${Astro.url.pathname}`} />
    <link rel="icon" type="image/png" href="/icons/escala-favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <main>
      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-wrapper">
          <div class="hero-banner">
            <div class="hero-container">
              <h1 class="hero-title-contacto">
                Somos tu aliado de transformación
              </h1>
              <p class="hero-subtitle-contacto">
                Te ayudamos a convertir la nube en motor de crecimiento.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Form Section -->
      <section class="contact-form-section" id="contact-form-wrapper">
        <div class="contact-form-background">
          <img src="/images/soluciones_tabs_bg.jpg" alt="" class="contact-form-bg-img" />
        </div>

        <div class="contact-form-container">
          <!-- Title at the top -->
          <h2 class="contact-form-title">
            Hablemos de lo<br />
            que necesitas.
          </h2>

          <div class="contact-form-content">
            <!-- Left Column -->
            <div class="contact-form-left">
              <p class="contact-form-intro-title">Estamos presentes donde estés.</p>
              <div class="interactive-map-wrapper">
                <div class="interactive-map" id="interactive-map" role="img" aria-label="Mapa de países donde operamos">
                  <div class="interactive-map__bg" style="background-image: url('/images/escala-map.jpg');"></div>
                  {mapLocations.map((loc) => (
                    <button
                      type="button"
                      class="interactive-map__marker"
                      data-marker={loc.id}
                      style={`--left: ${loc.left}; --top: ${loc.top};`}
                      aria-label={loc.title}
                    />
                  ))}
                  <div class="interactive-map__card" id="map-card" hidden>
                    <div class="interactive-map__card-header">
                      <img src="" alt="" class="interactive-map__card-flag" id="map-card-flag" width="40" height="40" />
                      <h3 class="interactive-map__card-title" id="map-card-title"></h3>
                    </div>
                    <p class="interactive-map__card-text" id="map-card-text"></p>
                  </div>
                </div>
                <div class="interactive-map__flags" id="map-flags" aria-label="Seleccionar país">
                  {mapLocations.map((loc) => (
                    <button type="button" class="interactive-map__flag-btn" data-marker={loc.id} aria-label={loc.title}>
                      <img src={loc.flag} alt="" width="32" height="32" />
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Column -->
            <div class="contact-form-right">
              <p class="form-card-title">Da el primer paso.</p>
              <p class="form-card-text">
                Déjanos tus datos y uno de nuestros expertos se pondrá en contacto contigo para acompañarte en tu camino de transformación digital con AWS.
              </p>

              <HubSpotFormContacto lang={lang} />
            </div>
          </div>
        </div>
      </section>

      <Footer lang={lang} />
    </main>

    <script define:vars={{ mapLocations }}>
      (function () {
        const map = document.getElementById('interactive-map');
        const card = document.getElementById('map-card');
        const cardTitle = document.getElementById('map-card-title');
        const cardText = document.getElementById('map-card-text');
        const cardFlag = document.getElementById('map-card-flag');
        if (!map || !card || !cardTitle || !cardText || !cardFlag) return;

        const locations = {};
        mapLocations.forEach((loc) => {
          locations[loc.id] = { title: loc.title, text: loc.text, flag: loc.flag };
        });

        function openCard(id) {
          const loc = locations[id];
          if (!loc || !map || !card || !cardFlag || !cardTitle || !cardText) return;
          const marker = map.querySelector('.interactive-map__marker[data-marker="' + id + '"]');
          if (marker) {
            card.style.setProperty('--card-left', marker.style.getPropertyValue('--left') || '50%');
            card.style.setProperty('--card-top', marker.style.getPropertyValue('--top') || '50%');
          }
          map.querySelectorAll('.interactive-map__marker').forEach((m) => m.classList.remove('active'));
          document.querySelectorAll('.interactive-map__flag-btn').forEach((b) => b.classList.remove('active'));
          if (marker) marker.classList.add('active');
          const flagBtn = document.querySelector('.interactive-map__flag-btn[data-marker="' + id + '"]');
          if (flagBtn) flagBtn.classList.add('active');
          cardFlag.src = loc.flag;
          cardFlag.alt = loc.title;
          cardTitle.textContent = loc.title.toUpperCase();
          cardText.textContent = loc.text;
          card.removeAttribute('hidden');
        }

        function closeCard() {
          if (card) card.setAttribute('hidden', '');
          if (map) map.querySelectorAll('.interactive-map__marker').forEach((m) => m.classList.remove('active'));
          document.querySelectorAll('.interactive-map__flag-btn').forEach((b) => b.classList.remove('active'));
        }

        map.addEventListener('click', (e) => {
          const marker = e.target.closest('.interactive-map__marker');
          if (marker) {
            e.stopPropagation();
            const id = marker.getAttribute('data-marker');
            if (id) openCard(id);
          }
        });

        const flagsEl = document.getElementById('map-flags');
        if (flagsEl) {
          flagsEl.addEventListener('click', (e) => {
            e.stopPropagation();
            const btn = e.target.closest('.interactive-map__flag-btn');
            if (btn) {
              const id = btn.getAttribute('data-marker');
              if (id) openCard(id);
            }
          });
        }

        document.addEventListener('click', () => closeCard());
        card.addEventListener('click', (e) => e.stopPropagation());
      })();
    </script>
  </body>
</html>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    width: 100%;
    background-color: #0c0c0c;
  }

  .hero-wrapper {
    padding: 24px;
    height: 70vh;
    min-height: 700px;
  }

  .hero-banner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    background-image: url("/images/industrias/industrias-hero.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding-top: 100px;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 100px;
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 100px);
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero-title-contacto {
    color: var(--neutral-100);
    font-family: 'Nexa', sans-serif;
    font-size: 64px;
    font-weight: 500;
    line-height: 59px;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }

  .hero-subtitle-contacto {
    color: var(--neutral-100);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.6;
    opacity: 0.9;
    max-width: 600px;
  }

  /* Contact Form Section */
  .contact-form-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 0;
  }

  .contact-form-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .contact-form-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .contact-form-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 100px;
    width: 100%;
    z-index: 1;
  }

  .contact-form-title {
    color: #1A1A1A;
    font-family: 'Nexa', sans-serif;
    font-size: 56px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 3rem 0;
    text-align: left;
  }

  .contact-form-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-form-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-form-intro-title {
    color: #1A1A1A;
    font-family: 'Nexa', sans-serif;
    font-size: 24px;
    font-weight: 600;
    margin: 0;
  }

  /* Interactive map: 100% ancho de la columna, sin borde ni margen, altura automática.
     Proporción del contenedor = proporción de escala-map.jpg (1278×1154) para que no se recorte. */
  .interactive-map-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .interactive-map {
    position: relative;
    width: 100%;
    /* Misma proporción que public/images/escala-map.jpg (1278 / 1154) → mapa completo sin recorte */
    aspect-ratio: 1278 / 1154;
    overflow: hidden;
    background: #041e42;
    margin: 0;
    border: none;
    border-radius: 16px;
  }

  .interactive-map__bg {
    position: absolute;
    inset: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }

  .interactive-map__marker {
    position: absolute;
    left: var(--left, 50%);
    top: var(--top, 50%);
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.95);
    cursor: pointer;
    padding: 0;
    z-index: 2;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .interactive-map__marker:hover {
    transform: translate(-50%, -50%) scale(1.2);
    box-shadow: 0 0 0 4px rgba(0, 193, 159, 0.3);
  }

  .interactive-map__marker.active {
    background: #00c19f;
    border-color: #00c19f;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5);
  }

  .interactive-map__flags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .interactive-map__flag-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .interactive-map__flag-btn:hover {
    border-color: rgba(255, 255, 255, 0.5);
    transform: scale(1.05);
  }

  .interactive-map__flag-btn.active {
    border-color: #00c19f;
    box-shadow: 0 0 0 2px rgba(0, 193, 159, 0.4);
  }

  .interactive-map__flag-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .interactive-map__card {
    position: absolute;
    z-index: 10;
    left: var(--card-left, 50%);
    top: var(--card-top, 50%);
    transform: translate(-50%, -50%);
    width: calc(100% - 2rem);
    max-width: 250px;
    padding: 16px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
    pointer-events: auto;
  }

  .interactive-map__card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .interactive-map__card-flag {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .interactive-map__card-title {
    margin: 0;
    font-family: 'Nexa', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .interactive-map__card-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.2;
    color: #444;
  }

  .contact-form-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    top: -60px;
  }

  .form-card-title {
    color: #1a1a1a;
    font-family: 'Infra', sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .form-card-text {
    color: #1a1a1a;
    font-family: 'Infra', sans-serif;
    font-size: 18px;
    line-height: 20px;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .hero-wrapper {
      min-height: 500px;
      padding: 16px;
    }

    .hero-container {
      padding: 0 40px;
    }

    .hero-title-contacto {
      font-size: 48px;
      line-height: 1.1;
    }

    .hero-subtitle-contacto {
      font-size: 18px;
    }

    .contact-form-section {
      padding: 60px 0;
    }

    .contact-form-container {
      padding: 0 50px;
    }

    .contact-form-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-form-right {
      top: 0;
    }

    .contact-form-title {
      font-size: 42px;
    }

    .interactive-map-wrapper {
      max-width: 100%;
    }

    .interactive-map {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hero-wrapper {
      min-height: 400px;
      padding: 12px;
    }

    .hero-container {
      padding: 0 24px;
    }

    .hero-title-contacto {
      font-size: 36px;
      line-height: 1.15;
      margin-bottom: 1rem;
    }

    .hero-subtitle-contacto {
      font-size: 16px;
    }

    .contact-form-section {
      padding: 48px 0;
    }

    .contact-form-container {
      padding: 0 24px;
    }

    .contact-form-title {
      font-size: 32px;
      margin-bottom: 2rem;
    }

    .contact-form-intro-title {
      font-size: 20px;
    }

    .interactive-map-wrapper {
      max-width: 100%;
    }

    .interactive-map {
      height: auto;
    }

    .interactive-map__card {
      max-width: 220px;
      padding: 12px;
    }

    .interactive-map__card-title {
      font-size: 16px;
    }

    .interactive-map__card-text {
      font-size: 13px;
    }

    .interactive-map__flag-btn {
      width: 40px;
      height: 40px;
    }

    .interactive-map__flags {
      gap: 0.4rem;
    }

    .form-card-title {
      font-size: 20px;
    }

    .form-card-text {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .hero-wrapper {
      min-height: 320px;
    }

    .hero-container {
      padding: 0 16px;
    }

    .hero-title-contacto {
      font-size: 28px;
    }

    .hero-subtitle-contacto {
      font-size: 14px;
    }

    .contact-form-section {
      padding: 32px 0;
    }

    .contact-form-container {
      padding: 0 16px;
    }

    .contact-form-title {
      font-size: 26px;
      margin-bottom: 1.5rem;
    }

    .contact-form-intro-title {
      font-size: 18px;
    }

    .interactive-map__marker {
      width: 12px;
      height: 12px;
    }

    .interactive-map__card {
      max-width: calc(100% - 1.5rem);
      padding: 10px;
    }

    .interactive-map__card-header {
      gap: 0.5rem;
    }

    .interactive-map__card-flag {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .interactive-map__card-title {
      font-size: 14px;
    }

    .interactive-map__card-text {
      font-size: 12px;
    }

    .interactive-map__flag-btn {
      width: 36px;
      height: 36px;
    }

    .interactive-map__flags {
      gap: 0.35rem;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .form-card-title {
      font-size: 18px;
    }

    .form-card-text {
      font-size: 14px;
    }
  }
</style>
