# CookieFlow-compatible consent audit (Supabase REST). Copy to `.env` / set in the host.
PUBLIC_COOKIEFLOW_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_COOKIEFLOW_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: Reform geo worker (default is CookieFlow’s worker).
# PUBLIC_COOKIEFLOW_GEO_WORKER_URL=https://cookieflow-geo.reformdigital.workers.dev/

# Optional: extra ISO 3166-1 alpha-2 codes merged into ZONE_3 (same idea as rd-zone-3 additions).
# PUBLIC_COOKIEFLOW_ZONE3_EXTRA_ISO=
